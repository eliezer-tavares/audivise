# ============================================================
# AUDIVISE 1.0 — .editorconfig
# Arquitetado por Eliezer Tavares de Oliveira. Licença: GPLv3.
# ============================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,txt}]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.{json,yml,yaml,toml,webmanifest}]
indent_size = 2

[Makefile]
indent_style = tab
